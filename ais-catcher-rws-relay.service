[Unit]
Description=Restricted Rijkswaterstaat data relay for AIS-Catcher VTS overlay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/ais-catcher-rws-relay/rws_proxy.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryMax=64M
UMask=0077

[Install]
WantedBy=multi-user.target
