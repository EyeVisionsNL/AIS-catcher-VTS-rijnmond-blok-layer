  function hexToRgba(hex, alpha) {
    var h = hex.replace('#', '');
    var r = parseInt(h.substring(0, 2), 16);
    var g = parseInt(h.substring(2, 4), 16);
    var b = parseInt(h.substring(4, 6), 16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

  function projectRing(ring) {
    return ring.map(function(lonlat) {
      return ol.proj.fromLonLat([lonlat[0], lonlat[1]]);
    });
  }

  var patchRings = OUDE_MAAS_WEST.coordinates.map(projectRing);
  var patchFeature = new ol.Feature({
    geometry: new ol.geom.Polygon(patchRings)
  });

  patchFeature.set('name', 'Sector Oude Maas - VHF 62');
  patchFeature.set('sector', 'Sector Oude Maas');
  patchFeature.set('vhfchannel', '62');
  patchFeature.set('source', 'Rijkswaterstaat KRW + vts-deelsector 14184');

  patchFeature.setStyle(new ol.style.Style({
    fill: new ol.style.Fill({
      color: hexToRgba('#8f72bd', 0.32)
    }),
    stroke: new ol.style.Stroke({
      color: hexToRgba('#8f72bd', 0.95),
      width: 1.6
    })
  }));

  var patchLayer = new ol.layer.Vector({
    source: new ol.source.Vector({ features: [patchFeature] }),
    zIndex: 1001
  });

  // AIS-Catcher v5 stelt Tile en Vector beschikbaar, maar geen LayerGroup.
  // Daarom worden basis en correctie als twee gekoppelde overlays toegevoegd.
  AISCatcher.addOverlayLayer('Rijnmond VTS sectoren', baseLayer);
  AISCatcher.addOverlayLayer('Rijnmond VTS - Oude Maas west', patchLayer);

  console.info(
    '[AIS VTS] v12 geladen: officiële RWS sectorlaag + Oude Maas west-aanvulling.'
  );
}
