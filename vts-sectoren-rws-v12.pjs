  var COLORS = {
    '3':  '#ff8a00', // Maas Entrance / Maasmond
    '66': '#58b8b1', // Europoort
    '65': '#1459a6', // Rozenburg
    '80': '#55a91d', // Maassluis
    '61': '#e5007e', // Botlek
    '62': '#8f72bd', // Oude Maas
    '63': '#b79b72', // Eemhaven
    '60': '#8d0065', // Waalhaven
    '81': '#00a9df'  // Maasbruggen
  };

  function hexToRgba(hex, alpha) {
    var h = hex.replace('#', '');
    var r = parseInt(h.substring(0, 2), 16);
    var g = parseInt(h.substring(2, 4), 16);
    var b = parseInt(h.substring(4, 6), 16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

  function projectRing(ring) {
    return ring.map(function(lonlat) {
      return ol.proj.fromLonLat([lonlat[0], lonlat[1]]);
    });
  }

  function makeFeature(item) {
    var rings = item.geometry.coordinates.map(projectRing);
    var feature = new ol.Feature({
      geometry: new ol.geom.Polygon(rings)
    });

    var name = item.properties.name;
    var vhf = String(item.properties.vhfchannel);
    var color = COLORS[vhf] || '#777777';

    feature.set('name', name + ' - VHF ' + vhf);
    feature.set('sector', name);
    feature.set('vhfchannel', vhf);
    feature.set('source', 'Rijkswaterstaat vts-deelsector_v');

    feature.setStyle(new ol.style.Style({
      fill: new ol.style.Fill({
        color: hexToRgba(color, 0.32)
      }),
      stroke: new ol.style.Stroke({
        color: hexToRgba(color, 0.95),
        width: 1.6
      })
    }));

    return feature;
  }

