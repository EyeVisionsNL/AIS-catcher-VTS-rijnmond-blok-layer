// {"author":"Coen","version":5,"description":"Rijnmond VTS sectoren v12 - officiële RWS sectoren met Oude Maas west-aanvulling"}
if (typeof AISCatcher !== 'undefined' &&
    AISCatcher.PLUGIN_API_VERSION >= 5 &&
    typeof ol !== 'undefined') {

  /*
   * Rijnmond VTS sectoren v12
   * -------------------------
   * Basis:
   * - officiële Rijkswaterstaat vts-deelsector_v polygonlaag 67;
   * - live gerenderd via ArcGIS MapServer Export, zoals v10.
   *
   * Correctie VHF 62 Oude Maas west:
   * - watergrenzen uit officiële RWS KRW-oppervlaktewaterlichamen;
   * - traject gebaseerd op officiële RWS vts-deelsector route 14184;
   * - westgrens afgeleid van het officiële route-eindpunt;
   * - geen handgetekende oeverlijnen of arbitraire bufferband.
   *
   * De aanvulling is lokaal ingebakken zodat alleen de basislaag een
   * internetverbinding naar Rijkswaterstaat nodig heeft.
   */

  var EXPORT_URL =
    'https://geo.rijkswaterstaat.nl/arcgis/rest/services/GDR/fis_vnds/MapServer/export';

  var COLORS = {
    '3':  [255,138,0],
    '66': [88,184,177],
    '65': [20,89,166],
    '80': [85,169,29],
    '61': [229,0,126],
    '62': [143,114,189],
    '63': [183,155,114],
    '60': [141,0,101],
    '81': [0,169,223]
  };

  var LABELS = {
    '3':  'VHF 3 MAAS ENTRANCE',
    '66': 'VHF 66 EUROPOORT',
    '65': 'VHF 65 ROZENBURG',
    '80': 'VHF 80 MAASSLUIS',
    '61': 'VHF 61 BOTLEK',
    '62': 'VHF 62 OUDE MAAS',
    '63': 'VHF 63 EEMHAVEN',
    '60': 'VHF 60 WAALHAVEN',
    '81': 'VHF 81 MAASBRUGGEN'
  };

  function symbolFor(vhf) {
    var c = COLORS[vhf];
    return {
      value: vhf,
      label: LABELS[vhf],
      symbol: {
        type: 'esriSFS',
        style: 'esriSFSSolid',
        color: [c[0], c[1], c[2], 82],
        outline: {
          type: 'esriSLS',
          style: 'esriSLSSolid',
          color: [c[0], c[1], c[2], 235],
          width: 1.4
        }
      }
    };
  }

  var CHANNELS = ['3','66','65','80','61','62','63','60','81'];

  var DYNAMIC_LAYERS = JSON.stringify([{
    id: 67,
    source: { type: 'mapLayer', mapLayerId: 67 },
    definitionExpression: "vhfchannel IN ('3','66','65','80','61','62','63','60','81')",
    drawingInfo: {
      renderer: {
        type: 'uniqueValue',
        field1: 'vhfchannel',
        defaultSymbol: null,
        uniqueValueInfos: CHANNELS.map(symbolFor)
      }
    }
  }]);

  var ORIGIN = 20037508.342789244;

  function tileExtent3857(z, x, y) {
    var tiles = Math.pow(2, z);
    var span = (ORIGIN * 2) / tiles;
    var minX = -ORIGIN + (x * span);
    var maxX = minX + span;
    var maxY = ORIGIN - (y * span);
    var minY = maxY - span;
    return [minX, minY, maxX, maxY];
  }

  var baseSource = new ol.source.XYZ({
    maxZoom: 20,
    wrapX: false,
    tileUrlFunction: function(tileCoord) {
      if (!tileCoord) return undefined;

      var z = tileCoord[0];
      var x = tileCoord[1];
      var y = tileCoord[2];
      var n = Math.pow(2, z);
      if (x < 0 || x >= n || y < 0 || y >= n) return undefined;

      var bbox = tileExtent3857(z, x, y);
      return EXPORT_URL +
        '?f=image' +
        '&bbox=' + bbox.join(',') +
        '&bboxSR=3857' +
        '&imageSR=3857' +
        '&size=256,256' +
        '&dpi=96' +
        '&format=png32' +
        '&transparent=true' +
        '&dynamicLayers=' + encodeURIComponent(DYNAMIC_LAYERS);
    },
    attributions: 'VTS-sectoren © Rijkswaterstaat'
  });

  var baseLayer = new ol.layer.Tile({
    source: baseSource,
    opacity: 1,
    zIndex: 1000
  });

  var OUDE_MAAS_WEST = {"type":"Polygon","coordinates":[[[4.237254631683239,51.8836642993098],[4.237018811344248,51.88346303161792],[4.237231516722453,51.883356766689325],[4.237065077623128,51.88315319062791],[4.2372651069755385,51.8830865599684],[4.237328846872729,51.883095984480946],[4.23734657942603,51.88312972138994],[4.2390093027208025,51.882522641719994],[4.241902834437578,51.88149667870411],[4.2420594718657165,51.88167339562356],[4.242678754417797,51.881459142139384],[4.242800424596801,51.881417042441214],[4.242928512736421,51.88137272735276],[4.243060117558747,51.88132719332796],[4.243000921466907,51.881261174501475],[4.243132163796468,51.88121457256509],[4.243192999876027,51.88128121855916],[4.243310721190665,51.88124049293547],[4.243436279233429,51.88119704795618],[4.243537133915018,51.88116215526599],[4.243474606993194,51.88109413204141],[4.2435251135356475,51.88107636555476],[4.243587838227444,51.88114461001086],[4.243692877811859,51.88110826577556],[4.243789675940918,51.88107477879547],[4.243727391172298,51.88100521914414],[4.243777906411744,51.88098744544378],[4.243840379920494,51.88105723882298],[4.243942233449364,51.88102199595633],[4.244062948642545,51.880980230847165],[4.2439986464589206,51.880911058001736],[4.24407180873752,51.88088526176507],[4.24413614554026,51.88095490413418],[4.245001290115259,51.88065556890867],[4.244932562100592,51.88058001985409],[4.244983171664463,51.88056238319345],[4.245051972826611,51.88063802821337],[4.245755136333132,51.88039472939139],[4.245670221484947,51.88030098601717],[4.245718730098522,51.88028209532156],[4.245805088618994,51.88037744555109],[4.246450042708627,51.88015428020119],[4.24637054510043,51.88006337297919],[4.246484365836184,51.88002501537416],[4.246567512208447,51.880113628014456],[4.247432190944947,51.879814423415276],[4.247351315348875,51.87972442216508],[4.247403203820418,51.87970816861804],[4.2474828951421575,51.87979687650054],[4.248236193999578,51.87953620293435],[4.248150444062327,51.87944077052